#!/usr/bin/env xdg-open
[Desktop Entry]
Name=Boxes
GenericName=Virtual machine viewer/manager
Comment=View and use virtual machines
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=virtual machine;vm;
Exec=gnome-boxes %U
# Translators: Do NOT translate or transliterate this text (this is an icon file name)!
Icon=/usr/share/icons/HighContrast/256x256/apps/gnome-boxes.png
Terminal=false
Type=Application
StartupNotify=true
Categories=GNOME;GTK;System;Emulator;
MimeType=application/x-cd-image;
DBusActivatable=true
